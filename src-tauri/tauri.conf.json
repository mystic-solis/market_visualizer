{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "market-visualizer",
  "version": "0.20.0",
  "identifier": "com.market.visualizer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Market Visualizer",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.ico",
      "icons/logo.svg"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3MzY1NTBGQzRENUM5MzkKUldRNXlkWEVEMVUyNSszY0c3M295QmxCRFpFQ2lSWWpvQllUVGI1aWdnVGwyLzVNbm90eURBZFMK",
      "endpoints": [
        "https://github.com/mystic-solis/market_visualizer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}